# ============================================================
# Remon Developer — Пример переменных окружения
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ============================================================

# ─── База данных ────────────────────────────────────────────
POSTGRES_USER=remon_user
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=remon_db
DATABASE_URL=postgresql://remon_user:ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ@db:5432/remon_db

# ─── JWT ────────────────────────────────────────────────────
# Генерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_67890

# ─── Сервер ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://raemon.ru
OAUTH_REDIRECT_BASE=https://raemon.ru

# ─── VK OAuth ───────────────────────────────────────────────
# Создать приложение: https://vk.com/editapp?act=create
# Тип: Веб-сайт, адрес сайта: https://raemon.ru
# Redirect URI: https://raemon.ru/api/auth/vk/callback
VK_APP_ID=
VK_APP_SECRET=

# ─── Яндекс OAuth ───────────────────────────────────────────
# Создать приложение: https://oauth.yandex.ru/client/new
# Callback URL: https://raemon.ru/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ─── Telegram Bot ───────────────────────────────────────────
# Создать бота: @BotFather → /newbot
# Получить токен и вставить сюда
TELEGRAM_BOT_TOKEN=1234567890:AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKK
# Имя бота (без @), используется на фронтенде
NEXT_PUBLIC_TELEGRAM_BOT_NAME=Remon_Demo_Bot

# ─── Системные пользователи ─────────────────────────────────
# Пароли обновляются автоматически при старте бэкенда (src/seed.ts)
ADMIN_EMAIL=admin@raemon.ru
ADMIN_PASSWORD=AdminPassword123!
RESIDENT_EMAIL=resident@raemon.ru
RESIDENT_PASSWORD=ResidentPassword123!

# ─── Фронтенд ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://raemon.ru
