# ─── Переменные окружения (НИКОГДА не коммитить) ───────────────────────────
.env
.env.local
.env.production
.env.development
*.env

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Next.js ────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/

# ─── TypeScript ─────────────────────────────────────────────────────────────
backend/dist/
*.tsbuildinfo

# ─── SSL-сертификаты (генерируются на сервере через certbot) ────────────────
certbot/conf/
certbot/www/

# ─── PostgreSQL данные (хранятся в Docker volume) ───────────────────────────
postgres_data/

# ─── Логи ───────────────────────────────────────────────────────────────────
logs/
*.log

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Референсы (большие HTML-файлы, не нужны на сервере) ───────────────────
*.html
!frontend/public/**/*.html

# ─── Прочее ─────────────────────────────────────────────────────────────────
*.zip
*.tar.gz

